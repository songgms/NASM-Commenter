          0,
          0
        ]
      },
      {
        "index": 1,
        "operand": 1,
        "mustBe": "rsp"
      },
      {
        "index": 2,
        "operand": 0,
        "sameAs": [
          1,
          1
        ]
      },
      {
        "index": 2,
        "operand": 1,
        "isImmediate": true
      }
    ],
    "comments": [
      "保存旧栈帧指针 rbp",
      "设置新栈帧指针: rbp = rsp",
      "分配 {imm} 字节局部变量空间"
    ],
    "comments_en": [
      "save old frame pointer rbp",
      "set frame pointer: rbp = rsp",
      "allocate {imm} bytes of locals"
