  {
    "id": "function-prologue-standard",
    "name": "函数序言(标准)",
    "description": "push rbp / mov rbp,rsp / sub rsp,N 标准函数序言",
    "sequence": [
      "push",
      "mov",
      "sub"
    ],
    "operandConstraints": [
      {
        "index": 0,
        "operand": 0,
